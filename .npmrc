# visx 3.12 declares react as a peer with a range that stops at 18. React 19
# does not satisfy it, so npm helpfully installs a second React beside the app
# to meet the peer, and that is the copy react/jsx-runtime then resolves to.
#
# The result is two Reacts in one bundle. In a browser the page dies on load
# with ReactCurrentOwner undefined; under vitest react-dom refuses the
# elements as coming from an older React. Neither message names the cause.
#
# An overrides block does not fix it, because overrides do not apply to peer
# ranges, and a bundler alias does not fix it either, because vitest loads
# packages it does not transform through node's own resolver.
#
# So: stop npm resolving peers for us, and let every package use the one React
# this repo installs. visx itself runs on React 19 without complaint, which is
# what the four panels in apps/linked-brush demonstrate. The range is stale
# metadata, not a real limit.
legacy-peer-deps=true
